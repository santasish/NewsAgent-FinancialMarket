# Copy to .env and fill in. Never commit .env.

# LLM (default provider: gemini). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional paid upgrades
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Google service account JSON, base64-encoded (Phase 4)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Failure alerts via Gmail SMTP (Phase 4)
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
GMAIL_APP_PASSWORD=
